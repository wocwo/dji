# 复制为 .env.agent 后填入自己的 Key；.env.agent 已被 .gitignore 忽略
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 可选：让不带 --config 的命令默认使用 DeepSeek
# AGENT_CONFIG=configs/agent.deepseek.yaml

# 可选：多用户；用户名 -> 密码。配置后所有接口要求 Basic Auth
# AGENT_USERS={"dji":"change-me","alice":"alice-pass"}
# 兼容单用户 / CI
# AGENT_ACCESS_TOKEN=change-me

# Qwen-VL 视觉观察（阿里云百炼 DashScope）
# 没配置时自动回退到本地 OCR
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 原生 SDK 走北京 MaaS 网关；普通 DashScope 可改回 dashscope.aliyuncs.com
QWEN_MODE=native
QWEN_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
# 只用非 OCR 视觉模型
QWEN_VL_MODEL=qwen3-vl-plus

# 可选：如果你想让默认命令直接走 DeepSeek，而不是 configs/agent.yaml 的 Ollama
# AGENT_LLM_PROVIDER=deepseek
# AGENT_LLM_MODEL=deepseek-flash
# AGENT_LLM_BASE_URL=https://api.deepseek.com
